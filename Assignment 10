1. Sum Triangle from Array (GFG)


import java.util.*;

public class SumTriangle {
    
    static void printTriangle(int[] arr, int n) {
        if (n == 1) {
            System.out.println(arr[0]);
            return;
        }

        int[] temp = new int[n - 1];

        for (int i = 0; i < n - 1; i++) {
            temp[i] = arr[i] + arr[i + 1];
        }

        printTriangle(temp, n - 1);

        for (int i = 0; i < n; i++) {
            System.out.print(arr[i] + " ");
        }
        System.out.println();
    }

    public static void main(String[] args) {
        int[] arr = {1, 2, 3, 4, 5};
        printTriangle(arr, arr.length);
    }
}



2. Maximum and Minimum Value in an Array (GFG)

public class MaxMinArray {

    static int max(int[] arr, int index) {
        if (index == arr.length - 1)
            return arr[index];

        return Math.max(arr[index], max(arr, index + 1));
    }

    static int min(int[] arr, int index) {
        if (index == arr.length - 1)
            return arr[index];

        return Math.min(arr[index], min(arr, index + 1));
    }

    public static void main(String[] args) {

        int[] arr = {5, 2, 9, 1, 7};

        System.out.println("Maximum: " + max(arr, 0));
        System.out.println("Minimum: " + min(arr, 0));
    }
}



3. Binary Search Using Recursion (LeetCode)

public class BinarySearch {

    static int search(int[] nums, int target, int start, int end) {

        if (start > end)
            return -1;

        int mid = start + (end - start) / 2;

        if (nums[mid] == target)
            return mid;

        if (nums[mid] > target)
            return search(nums, target, start, mid - 1);

        return search(nums, target, mid + 1, end);
    }

    public static void main(String[] args) {

        int[] nums = {-1,0,3,5,9,12};

        System.out.println(search(nums, 9, 0, nums.length - 1));
    }
}



4. First Uppercase Letter in a String (GFG)

public class FirstUppercase {

    static char findUpper(String str, int index) {

        if (index == str.length())
            return '\0';

        if (Character.isUpperCase(str.charAt(index)))
            return str.charAt(index);

        return findUpper(str, index + 1);
    }

    public static void main(String[] args) {

        String str = "geeksforgeeKs";

        char result = findUpper(str, 0);

        if(result == '\0')
            System.out.println("No uppercase letter");
        else
            System.out.println(result);
    }
}



5. Reverse String (LeetCode)

public class ReverseString {

    static void reverse(char[] s, int left, int right) {

        if(left >= right)
            return;

        char temp = s[left];
        s[left] = s[right];
        s[right] = temp;

        reverse(s, left + 1, right - 1);
    }

    public static void main(String[] args) {

        char[] s = {'h','e','l','l','o'};

        reverse(s,0,s.length-1);

        for(char c : s)
            System.out.print(c);
    }
}



