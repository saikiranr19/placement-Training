import java.util.*;

public class SpecialFibonacci {

    static long fib(long a, long b, int n) {

        if(n == 1)
            return a;

        if(n == 2)
            return b;

        return fib(b, a + b, n - 1);
    }


    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        long a = sc.nextLong();
        long b = sc.nextLong();
        int n = sc.nextInt();

        System.out.println(fib(a, b, n));
    }
}

