8. Pow(x,n) (LeetCode)

public class Power {

    static double pow(double x,long n){

        if(n==0)
            return 1;


        double half=pow(x,n/2);


        if(n%2==0)
            return half*half;


        return half*half*x;
    }


    public static void main(String[] args){

        int n=10;

        System.out.println(pow(2,n));
    }
}


