1. Parsing A Boolean Expression (LeetCode)


import java.util.*;

public class ParsingBooleanExpression {

    static boolean parse(String s, int[] index) {

        char ch = s.charAt(index[0]);

        if(ch == 't') {
            index[0]++;
            return true;
        }

        if(ch == 'f') {
            index[0]++;
            return false;
        }

        index[0]++; // skip operator
        index[0]++; // skip '('

        List<Boolean> values = new ArrayList<>();

        while(s.charAt(index[0]) != ')') {

            if(s.charAt(index[0]) == ',') {
                index[0]++;
            }
            else {
                values.add(parse(s,index));
            }
        }

        index[0]++; // skip ')'


        if(ch == '!') {
            return !values.get(0);
        }

        if(ch == '&') {

            for(boolean b : values)
                if(!b) return false;

            return true;
        }


        if(ch == '|') {

            for(boolean b : values)
                if(b) return true;

            return false;
        }

        return false;
    }


    public static void main(String[] args) {

        String exp="|(&(t,f,t),!(t))";

        System.out.println(parse(exp,new int[]{0}));
    }
}



2. Special Binary String (LeetCode)


import java.util.*;

public class SpecialBinaryString {

    static String makeLargestSpecial(String s) {

        List<String> list = new ArrayList<>();

        int count=0;
        int start=0;


        for(int i=0;i<s.length();i++) {

            if(s.charAt(i)=='1')
                count++;
            else
                count--;


            if(count==0) {

                String inner =
                    s.substring(start+1,i);

                list.add("1"+
                    makeLargestSpecial(inner)
                    +"0");

                start=i+1;
            }
        }


        Collections.sort(list,Collections.reverseOrder());

        StringBuilder ans=new StringBuilder();

        for(String str:list)
            ans.append(str);

        return ans.toString();
    }


    public static void main(String[] args){

        System.out.println(
          makeLargestSpecial("11011000")
        );
    }
}



3. Permutation Sequence (LeetCode)

import java.util.*;

public class PermutationSequence {


    static String getPermutation(int n,int k){

        List<Integer> nums=new ArrayList<>();

        int fact=1;

        for(int i=1;i<n;i++){
            fact*=i;
        }


        for(int i=1;i<=n;i++)
            nums.add(i);


        k--;


        StringBuilder ans=new StringBuilder();


        while(true){

            ans.append(nums.get(k/fact));

            nums.remove(k/fact);


            if(nums.size()==0)
                break;


            k%=fact;

            fact/=nums.size();
        }


        return ans.toString();
    }


    public static void main(String[] args){

        System.out.println(
          getPermutation(3,3)
        );
    }
}



4. Next Happy Number (GFG)

public class NextHappyNumber {


    static int sumSquare(int n){

        int sum=0;

        while(n>0){

            int d=n%10;

            sum+=d*d;

            n/=10;
        }

        return sum;
    }


    static boolean isHappy(int n){

        int slow=n;
        int fast=n;


        do{

            slow=sumSquare(slow);

            fast=sumSquare(sumSquare(fast));


        }while(slow!=fast);


        return slow==1;
    }


    static int nextHappy(int n){

        n++;

        while(!isHappy(n))
            n++;

        return n;
    }


    public static void main(String[] args){

        System.out.println(nextHappy(8));
    }
}



5. Basic Calculator (LeetCode)


import java.util.*;

public class BasicCalculator {


    static int calculate(String s){

        Stack<Integer> stack=new Stack<>();

        int result=0;
        int number=0;
        int sign=1;


        for(int i=0;i<s.length();i++){

            char c=s.charAt(i);


            if(Character.isDigit(c)){

                number=number*10+(c-'0');
            }

            else if(c=='+'){

                result+=sign*number;

                number=0;

                sign=1;
            }

            else if(c=='-'){

                result+=sign*number;

                number=0;

                sign=-1;
            }

            else if(c=='('){

                stack.push(result);

                stack.push(sign);

                result=0;

                sign=1;
            }

            else if(c==')'){

                result+=sign*number;

                number=0;

                result*=stack.pop();

                result+=stack.pop();
            }
        }


        return result+sign*number;
    }


    public static void main(String[] args){

        System.out.println(
          calculate("(1+(4+5+2)-3)+(6+8)")
        );
    }
}



6. Integer to English Words (LeetCode)

public class IntegerToEnglishWords {


    static String[] below20={
        "","One","Two","Three","Four","Five",
        "Six","Seven","Eight","Nine","Ten",
        "Eleven","Twelve","Thirteen","Fourteen",
        "Fifteen","Sixteen","Seventeen",
        "Eighteen","Nineteen"
    };


    static String[] tens={
        "","","Twenty","Thirty","Forty",
        "Fifty","Sixty","Seventy","Eighty","Ninety"
    };


    static String convert(int n){

        if(n<20)
            return below20[n];

        if(n<100)
            return tens[n/10]+" "+convert(n%10);

        if(n<1000)
            return convert(n/100)+" Hundred "+convert(n%100);


        if(n<1000000)
            return convert(n/1000)+" Thousand "+convert(n%1000);


        if(n<1000000000)
            return convert(n/1000000)+" Million "+convert(n%1000000);


        return convert(n/1000000000)+" Billion "+convert(n%1000000000);
    }


    public static void main(String[] args){

        System.out.println(convert(12345));
    }
}
