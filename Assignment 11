1. Minimum Number of Flips to Convert Binary Matrix to Zero Matrix (LeetCode)


import java.util.*;

public class MinFlipsMatrix {


    static int minFlips(int[][] mat) {

        int m = mat.length;
        int n = mat[0].length;


        int start = 0;


        for(int i=0;i<m;i++){
            for(int j=0;j<n;j++){

                if(mat[i][j]==1)
                    start |= 1 << (i*n+j);
            }
        }


        Queue<Integer> q = new LinkedList<>();

        Set<Integer> visited = new HashSet<>();

        q.add(start);
        visited.add(start);


        int steps = 0;


        while(!q.isEmpty()){


            int size=q.size();


            while(size-- > 0){

                int state=q.poll();


                if(state==0)
                    return steps;


                for(int i=0;i<m;i++){

                    for(int j=0;j<n;j++){


                        int next=state;


                        int[][] dir={
                            {0,0},{1,0},{-1,0},
                            {0,1},{0,-1}
                        };


                        for(int[] d:dir){

                            int x=i+d[0];
                            int y=j+d[1];


                            if(x>=0 && y>=0 &&
                               x<m && y<n){

                                next ^= 1 << (x*n+y);
                            }
                        }


                        if(!visited.contains(next)){

                            visited.add(next);

                            q.add(next);
                        }
                    }
                }
            }

            steps++;
        }


        return -1;
    }


    public static void main(String[] args){

        int[][] mat={
            {0,0},
            {0,1}
        };


        System.out.println(minFlips(mat));
    }
}



2. Minimum Cost to Connect Two Groups of Points (LeetCode)

import java.util.*;

public class ConnectTwoGroups {


    static int[][] cost;
    static int[][] dp;
    static int n,m;


    static int solve(int i,int mask){


        if(i==n){

            int ans=0;


            for(int j=0;j<m;j++){

                if((mask & (1<<j))==0){

                    int min=Integer.MAX_VALUE;


                    for(int k=0;k<n;k++)
                        min=Math.min(min,cost[k][j]);


                    ans+=min;
                }
            }


            return ans;
        }


        if(dp[i][mask]!=-1)
            return dp[i][mask];


        int result=Integer.MAX_VALUE;


        for(int j=0;j<m;j++){

            result=Math.min(
                result,
                cost[i][j]+solve(i+1,
                mask | (1<<j))
            );
        }


        return dp[i][mask]=result;
    }


    public static void main(String[] args){

        cost=new int[][]{
            {15,96},
            {36,2}
        };


        n=cost.length;
        m=cost[0].length;


        dp=new int[n][1<<m];


        for(int[] row:dp)
            Arrays.fill(row,-1);


        System.out.println(
            solve(0,0)
        );
    }
}



3. Find XOR Sum of All Pairs Bitwise AND (LeetCode)

public class XORSumPairs {


    static int getXORSum(int[] arr1,int[] arr2){


        int xor1=0;

        int xor2=0;


        for(int x:arr1)
            xor1 ^= x;


        for(int x:arr2)
            xor2 ^= x;


        return xor1 & xor2;
    }


    public static void main(String[] args){


        int arr1[]={1,2,3};

        int arr2[]={6,5};


        System.out.println(
            getXORSum(arr1,arr2)
        );
    }
}
