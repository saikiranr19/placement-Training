3. Reverse Bits (LeetCode)

public class ReverseBits {

    static int reverseBits(int n) {

        int result = 0;


        for(int i = 0; i < 32; i++) {

            result <<= 1;

            result |= (n & 1);

            n >>= 1;
        }


        return result;
    }


    public static void main(String[] args) {

        System.out.println(reverseBits(43261596));
    }
}



4. Number of 1 Bits (LeetCode)

public class NumberOfOneBits {

    static int hammingWeight(int n) {

        int count = 0;


        while(n != 0) {

            n = n & (n - 1);

            count++;
        }


        return count;
    }


    public static void main(String[] args) {

        System.out.println(hammingWeight(11));
    }
}



5. Counting Bits (LeetCode)


import java.util.Arrays;

public class CountingBits {

    static int[] countBits(int n) {

        int[] ans = new int[n+1];


        for(int i = 1; i <= n; i++) {

            ans[i] = ans[i >> 1] + (i & 1);
        }


        return ans;
    }


    public static void main(String[] args) {

        System.out.println(
            Arrays.toString(countBits(5))
        );
    }
}



6. Binary Watch (LeetCode)

import java.util.*;

public class BinaryWatch {


    static List<String> readBinaryWatch(int turnedOn) {

        List<String> ans = new ArrayList<>();


        for(int h = 0; h < 12; h++) {

            for(int m = 0; m < 60; m++) {

                if(Integer.bitCount(h) +
                   Integer.bitCount(m) == turnedOn) {


                    ans.add(
                        h + ":" +
                        (m < 10 ? "0" : "") + m
                    );
                }
            }
        }


        return ans;
    }


    public static void main(String[] args) {

        System.out.println(readBinaryWatch(1));
    }
}



7. Hamming Distance (LeetCode)

public class HammingDistance {

    static int hammingDistance(int x, int y) {

        int xor = x ^ y;

        int count = 0;


        while(xor != 0) {

            count += xor & 1;

            xor >>= 1;
        }


        return count;
    }


    public static void main(String[] args) {

        System.out.println(hammingDistance(1,4));
    }
}



8. Number Complement (LeetCode)

public class NumberComplement {


    static int findComplement(int num) {

        int mask = 0;

        int temp = num;


        while(temp != 0) {

            mask = (mask << 1) | 1;

            temp >>= 1;
        }


        return (~num) & mask;
    }


    public static void main(String[] args) {

        System.out.println(findComplement(5));
    }
}



9. Set Mismatch (LeetCode)


import java.util.*;

public class SetMismatch {


    static int[] findErrorNums(int[] nums) {

        int[] ans = new int[2];


        for(int n : nums) {

            int index = Math.abs(n)-1;


            if(nums[index] < 0)
                ans[0] = Math.abs(n);

            else
                nums[index] *= -1;
        }


        for(int i=0;i<nums.length;i++) {

            if(nums[i] > 0) {

                ans[1] = i+1;
                break;
            }
        }


        return ans;
    }


    public static void main(String[] args){

        System.out.println(
            Arrays.toString(
                findErrorNums(new int[]{1,2,2,4})
            )
        );
    }
}



10. Binary Number with Alternating Bits (LeetCode)

public class AlternatingBits {


    static boolean hasAlternatingBits(int n) {

        int previous = n & 1;

        n >>= 1;


        while(n > 0) {

            int current = n & 1;


            if(current == previous)
                return false;


            previous = current;

            n >>= 1;
        }


        return true;
    }


    public static void main(String[] args){

        System.out.println(
            hasAlternatingBits(5)
        );
    }
}



11. Prime Number of Set Bits in Binary Representation (LeetCode)

public class PrimeSetBits {


    static boolean isPrime(int n){

        if(n < 2)
            return false;


        for(int i=2;i*i<=n;i++){

            if(n%i==0)
                return false;
        }


        return true;
    }


    static int countPrimeSetBits(int left,int right){

        int count=0;


        for(int i=left;i<=right;i++){

            int bits=Integer.bitCount(i);


            if(isPrime(bits))
                count++;
        }


        return count;
    }


    public static void main(String[] args){

        System.out.println(
            countPrimeSetBits(6,10)
        );
    }
}

