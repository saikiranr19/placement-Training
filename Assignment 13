Recurrence Questions in Java

1. Fibonacci using Recurrence
class Solution {
    public int fibonacci(int n) {
        if (n <= 1) {
            return n;
        }

        return fibonacci(n - 1) + fibonacci(n - 2);
    }
}



2. Factorial using Recurrence

class Solution {
    public long factorial(int n) {
        if (n == 0 || n == 1) {
            return 1;
        }

        return n * factorial(n - 1);
    }
}



3. Power Calculation using Recurrence

class Solution {
    public double power(double x, int n) {
        if (n == 0) {
            return 1;
        }

        if (n < 0) {
            return 1 / power(x, -n);
        }

        double half = power(x, n / 2);

        if (n % 2 == 0) {
            return half * half;
        }

        return x * half * half;
    }
}



4. Binary Search using Recurrence

class Solution {

    public int binarySearch(int[] arr, int left, int right, int target) {

        if (left > right) {
            return -1;
        }

        int mid = left + (right - left) / 2;

        if (arr[mid] == target) {
            return mid;
        }

        if (target < arr[mid]) {
            return binarySearch(arr, left, mid - 1, target);
        }

        return binarySearch(arr, mid + 1, right, target);
    }
}



5. Merge Sort using Recurrence

class Solution {

    public void mergeSort(int[] arr, int left, int right) {

        if (left < right) {

            int mid = left + (right - left) / 2;

            mergeSort(arr, left, mid);
            mergeSort(arr, mid + 1, right);

            merge(arr, left, mid, right);
        }
    }


    private void merge(int[] arr, int left, int mid, int right) {

        int[] temp = new int[right - left + 1];

        int i = left;
        int j = mid + 1;
        int k = 0;


        while (i <= mid && j <= right) {

            if (arr[i] <= arr[j]) {
                temp[k++] = arr[i++];
            } 
            else {
                temp[k++] = arr[j++];
            }
        }


        while (i <= mid) {
            temp[k++] = arr[i++];
        }


        while (j <= right) {
            temp[k++] = arr[j++];
        }


        for (int x = 0; x < temp.length; x++) {
            arr[left + x] = temp[x];
        }
    }
}



6. Tower of Hanoi using Recurrence

class Solution {

    public void towerOfHanoi(int n, char source, char helper, char destination) {

        if (n == 1) {
            System.out.println("Move disk 1 from " 
                + source + " to " + destination);
            return;
        }

        towerOfHanoi(n - 1, source, destination, helper);

        System.out.println("Move disk " + n + " from " 
            + source + " to " + destination);

        towerOfHanoi(n - 1, helper, source, destination);
    }
}


