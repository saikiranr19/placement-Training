8. Sum of Array using Recurrence

class Solution {

    public int sumArray(int[] arr, int n) {

        if (n <= 0) {
            return 0;
        }

        return sumArray(arr, n - 1) + arr[n - 1];
    }
}



9. Greatest Common Divisor (Euclidean Recurrence)

class Solution {

    public int gcd(int a, int b) {

        if (b == 0) {
            return a;
        }

        return gcd(b, a % b);
    }
}



10. Recursive Tree Height

class Solution {

    public int height(TreeNode root) {

        if (root == null) {
            return 0;
        }

        int left = height(root.left);
        int right = height(root.right);

        return Math.max(left, right) + 1;
    }
}
