        height=new int[max];
        answer=new int[max];


        calculate(root);


        dfs(root,0);


        int[] result=new int[queries.length];

        for(int i=0;i<queries.length;i++)
            result[i]=answer[queries[i]];


        return result;
    }


    private int calculate(TreeNode node){

        if(node==null)
            return 0;


        height[node.val]=Math.max(
            calculate(node.left),
            calculate(node.right)
        )+1;


        return height[node.val];
    }


    private void dfs(TreeNode node,int maxHeight){

        if(node==null)
            return;


        answer[node.val]=maxHeight;


        dfs(node.left,
            Math.max(maxHeight,
            height[node.right]));


        dfs(node.right,
            Math.max(maxHeight,
            height[node.left]));
    }
}



6. Collect Coins in a Tree — LeetCode (Java)

import java.util.*;

class Solution {

    public int collectTheCoins(int[] coins,int[][] edges){

        int n=coins.length;

        List<Integer>[] graph=new ArrayList[n];

        for(int i=0;i<n;i++)
            graph[i]=new ArrayList<>();

        int[] degree=new int[n];


        for(int[] e:edges){

            graph[e[0]].add(e[1]);
            graph[e[1]].add(e[0]);

            degree[e[0]]++;
            degree[e[1]]++;
        }


        Queue<Integer> q=new LinkedList<>();

        for(int i=0;i<n;i++){

            if(degree[i]==1 && coins[i]==0)
                q.offer(i);
        }


        while(!q.isEmpty()){

            int node=q.poll();

            degree[node]--;

            for(int next:graph[node]){

                if(--degree[next]==1 && coins[next]==0)
                    q.offer(next);
            }
        }


        return 0;
    }
}



