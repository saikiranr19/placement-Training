            };
        }


        return new int[]{0,0,0,0};
    }
}



10. Minimize the Total Price of the Trips — LeetCode (Java)


class Solution {

    List<Integer>[] graph;
    int[] price;
    int[] count;


    public int minimumTotalPrice(
        int n,int[][] edges,int[] price,int[][] trips){

        this.price=price;

        graph=new ArrayList[n];

        for(int i=0;i<n;i++)
            graph[i]=new ArrayList<>();

        for(int[] e:edges){

            graph[e[0]].add(e[1]);
            graph[e[1]].add(e[0]);
        }


        count=new int[n];


        for(int[] trip:trips){

            find(trip[0],-1,trip[1]);
        }


        return (int)dfs(0,-1)[0];
    }


    private boolean find(int node,int parent,int target){

        if(node==target){

            count[node]++;
            return true;
        }


        for(int next:graph[node]){

            if(next!=parent &&
               find(next,node,target)){

                count[node]++;
                return true;
            }
        }

        return false;
    }


    private long[] dfs(int node,int parent){

        long no=price[node]*count[node];
        long yes=no/2;


        for(int next:graph[node]){

            if(next!=parent){

                long[] child=dfs(next,node);

                no+=Math.min(child[0],child[1]);
                yes+=child[0];
            }
        }


        return new long[]{no,yes};
    }
}


11. Number Of Ways To Reconstruct A Tree — LeetCode (Java)

import java.util.*;

class Solution {

    public int checkWays(int[][] pairs){

        Map<Integer,Set<Integer>> map=new HashMap<>();

        for(int[] p:pairs){

            map.putIfAbsent(p[0],new HashSet<>());
            map.putIfAbsent(p[1],new HashSet<>());

            map.get(p[0]).add(p[1]);
            map.get(p[1]).add(p[0]);
        }


        int root=-1;


        for(int node:map.keySet()){

            if(root==-1 ||
               map.get(node).size()>map.get(root).size())

                root=node;
        }


        if(map.get(root).size()!=map.size()-1)
            return 0;


        int result=1;


        for(int node:map.keySet()){

            if(node==root)
                continue;


            int parent=-1;


            for(int candidate:map.get(node)){

                if(map.get(candidate).size()>=map.get(node).size() &&
                   (parent==-1 ||
                    map.get(candidate).size()<map.get(parent).size()))

                    parent=candidate;
            }


            if(parent==-1)
                return 0;


            for(int neighbor:map.get(node)){

                if(neighbor!=parent &&
                   !map.get(parent).contains(neighbor))

                    return 0;
            }


            if(map.get(parent).size()==map.get(node).size())
                result=2;
        }


        return result;
    }
}
