import java.util.*;

class Solution {

    List<Integer>[] graph;
    int[] nums;
    int[] result;


    public int[] getCoprimes(int[] nums,int[][] edges){

        this.nums=nums;

        int n=nums.length;

        graph=new ArrayList[n];

        for(int i=0;i<n;i++)
            graph[i]=new ArrayList<>();

        for(int[] e:edges){

            graph[e[0]].add(e[1]);
            graph[e[1]].add(e[0]);
        }


        result=new int[n];

        Arrays.fill(result,-1);

        dfs(0,-1,new int[51],new int[51]);

        return result;
    }


    private void dfs(int node,int parent,int[] depth,int[] index){

        int bestDepth=-1;


        for(int i=1;i<=50;i++){

            if(depth[i]>0 &&
               gcd(nums[node],i)==1 &&
               depth[i]>bestDepth){

                bestDepth=depth[i];
                result[node]=index[i];
            }
        }


        int d=depth[nums[node]];
        int old=index[nums[node]];

        depth[nums[node]]=d+1;
        index[nums[node]]=node;


        for(int next:graph[node]){

            if(next!=parent)
                dfs(next,node,depth,index);
        }


        depth[nums[node]]=d;
        index[nums[node]]=old;
    }


    private int gcd(int a,int b){

        while(b!=0){

            int t=a%b;
            a=b;
            b=t;
        }

        return a;
    }
}



