7. Find Right Interval (LeetCode 436)

import java.util.*;

class Solution {
    public int[] findRightInterval(int[][] intervals) {

        int n = intervals.length;

        int[][] start = new int[n][2];

        for (int i = 0; i < n; i++) {
            start[i][0] = intervals[i][0];
            start[i][1] = i;
        }

        Arrays.sort(start, (a, b) -> a[0] - b[0]);

        int[] ans = new int[n];

        for (int i = 0; i < n; i++) {

            int index = binarySearch(start, intervals[i][1]);

            ans[i] = index;
        }

        return ans;
    }


    private int binarySearch(int[][] arr, int target) {

        int start = 0;
        int end = arr.length - 1;
        int ans = -1;

        while (start <= end) {

            int mid = start + (end - start) / 2;

            if (arr[mid][0] >= target) {
                ans = arr[mid][1];
                end = mid - 1;
            }
            else {
                start = mid + 1;
            }
        }

        return ans;
    }
}



8. Reach a Number (LeetCode 754)

class Solution {
    public int reachNumber(int target) {

        target = Math.abs(target);

        int sum = 0;
        int step = 0;

        while (sum < target || (sum - target) % 2 != 0) {

            step++;
            sum += step;
        }

        return step;
    }
}



9. Maximum Value at a Given Index in a Bounded Array (LeetCode 1802)

class Solution {
    public int maxValue(int n, int index, int maxSum) {

        int start = 1;
        int end = maxSum;
        int ans = 1;

        while (start <= end) {

            int mid = start + (end - start) / 2;

            if (isPossible(n, index, mid, maxSum)) {
                ans = mid;
                start = mid + 1;
            }
            else {
                end = mid - 1;
            }
        }

        return ans;
    }


    private boolean isPossible(int n, int index, int value, int maxSum) {

        long sum = value;

        long left = Math.min(index, value - 1);
        sum += left * (value - 1 + value - left) / 2;

        long right = Math.min(n - index - 1, value - 1);
        sum += right * (value - 1 + value - right) / 2;

        sum += Math.max(0, index - (value - 1));
        sum += Math.max(0, n - index - 1 - (value - 1));

        return sum <= maxSum;
    }
}



10. Koko Eating Bananas (LeetCode 875)

class Solution {
    public int minEatingSpeed(int[] piles, int h) {

        int start = 1;
        int end = 0;

        for (int pile : piles) {
            end = Math.max(end, pile);
        }

        int ans = end;

        while (start <= end) {

            int mid = start + (end - start) / 2;

            if (canEat(piles, h, mid)) {
                ans = mid;
                end = mid - 1;
            }
            else {
                start = mid + 1;
            }
        }

        return ans;
    }


    private boolean canEat(int[] piles, int h, int speed) {

        long hours = 0;

        for (int pile : piles) {
            hours += (pile + speed - 1) / speed;
        }

        return hours <= h;
    }
}

HARD



1. Median of Two Sorted Arrays (LeetCode 4)

class Solution {
    public double findMedianSortedArrays(int[] nums1, int[] nums2) {

        if (nums1.length > nums2.length) {
            return findMedianSortedArrays(nums2, nums1);
        }

        int m = nums1.length;
        int n = nums2.length;

        int low = 0;
        int high = m;

        while (low <= high) {

            int cut1 = (low + high) / 2;
            int cut2 = (m + n + 1) / 2 - cut1;

            int left1 = (cut1 == 0) ? Integer.MIN_VALUE : nums1[cut1 - 1];
            int right1 = (cut1 == m) ? Integer.MAX_VALUE : nums1[cut1];

            int left2 = (cut2 == 0) ? Integer.MIN_VALUE : nums2[cut2 - 1];
            int right2 = (cut2 == n) ? Integer.MAX_VALUE : nums2[cut2];

            if (left1 <= right2 && left2 <= right1) {

                if ((m + n) % 2 == 0) {
                    return (Math.max(left1, left2) +
                            Math.min(right1, right2)) / 2.0;
                } 
                else {
                    return Math.max(left1, left2);
                }
            }

            else if (left1 > right2) {
                high = cut1 - 1;
            }

            else {
                low = cut1 + 1;
            }
        }

        return 0.0;
    }
}




