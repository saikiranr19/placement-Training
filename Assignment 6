1. Square Root (LeetCode 69)

class Solution {
    public int mySqrt(int x) {

        if (x == 0)
            return 0;

        int start = 1;
        int end = x;
        int ans = 0;

        while (start <= end) {

            int mid = start + (end - start) / 2;

            if (mid <= x / mid) {
                ans = mid;
                start = mid + 1;
            } 
            else {
                end = mid - 1;
            }
        }

        return ans;
    }
}



2. Guess Number Higher or Lower (LeetCode 374)

class Solution {
    public int guessNumber(int n) {

        int start = 1;
        int end = n;

        while (start <= end) {

            int mid = start + (end - start) / 2;

            int result = guess(mid);

            if (result == 0)
                return mid;

            else if (result < 0)
                end = mid - 1;

            else
                start = mid + 1;
        }

        return -1;
    }
}



