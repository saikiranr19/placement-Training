5. Sorting the Sentence

class Solution:
    def sortSentence(self, s: str) -> str:
        words = s.split()
        result = [""] * len(words)

        for word in words:
            index = int(word[-1])
            result[index - 1] = word[:-1]

        return " ".join(result)



