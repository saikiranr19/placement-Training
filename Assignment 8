class Solution:
    def halvesAreAlike(self, s: str) -> bool:
        vowels = "aeiouAEIOU"

        mid = len(s) // 2

        left = 0
        right = 0

        for i in range(mid):
            if s[i] in vowels:
                left += 1

            if s[i + mid] in vowels:
                right += 1

        return left == right



9. Decrypt String from Alphabet to Integer Mapping

class Solution:
    def freqAlphabets(self, s: str) -> str:
        result = []
        i = len(s) - 1

        while i >= 0:
            if s[i] == '#':
                num = int(s[i-2:i])
                i -= 3
            else:
                num = int(s[i])
                i -= 1

            result.append(chr(96 + num))

        return "".join(result[::-1])



